{
  "name": "bloom-blocks",
  "private": true,
  "version": "1.0.0",
  "description": "Bloom Blocks - a cozy block puzzle for iOS & Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node sim/balance.ts",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run sim -- --gate && npm run build && npm run e2e",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5"
  }
}
